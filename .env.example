NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Use supabase for Vercel and a separately hosted worker. Use sqlite only for local mode.
NEWS_STORAGE=supabase
# Only used in sqlite mode; both app and worker must resolve the same file.
NEWS_DB_PATH=/data/news.sqlite
DATA_DIR=/data
