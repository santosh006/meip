{
  "name": "meip",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./scripts/register-ts.cjs --test tests/*.test.cjs",
    "test:python": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "worker": "node scripts/worker.cjs",
    "worker:start": "node scripts/hosted-worker.cjs start",
    "worker:stop": "node scripts/hosted-worker.cjs stop",
    "worker:status": "node scripts/hosted-worker.cjs status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.116.0",
    "better-sqlite3": "^11.10.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
